      "word_limit": 900,
      "required": true,
      "required_tables": [
        {
          "table_key": "review_summary_sheet",
          "label": "Annual Review Summary Sheet",
          "min_rows": 1,
          "data_source": "manual",
          "columns": [
            {"column_key": "programme_title", "label": "Programme title", "data_type": "text"},
            {"column_key": "programme_code", "label": "Programme code", "data_type": "text"},
            {"column_key": "review_date", "label": "Review date", "data_type": "date"},
