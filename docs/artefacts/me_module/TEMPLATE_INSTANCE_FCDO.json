  "format_rules_json": {
    "document_title": "FCDO Annual Review",
    "logframe": {
      "enabled": true,
      "levels": ["impact", "outcome", "output"],
      "columns": [
        {"column_key": "indicator", "label": "Indicator"},
        {"column_key": "baseline", "label": "Baseline"},
        {"column_key": "milestone", "label": "Milestone"},
        {"column_key": "target", "label": "Target"},
        {"column_key": "actual", "label": "Actual"},
        {"column_key": "score", "label": "Score"},
        {"column_key": "commentary", "label": "Commentary"}
      ],
      "source": "indicator_actuals_json"
    },
    "value_for_money": {
      "enabled": true,
      "metrics": [
        {"metric_key": "economy", "label": "Economy", "required": true},
        {"metric_key": "efficiency", "label": "Efficiency", "required": true},
        {"metric_key": "effectiveness", "label": "Effectiveness", "required": true},
        {"metric_key": "equity", "label": "Equity", "required": false}
      ],
      "narrative_section_key": "value_for_money",
      "word_limit": 1200
    },
    "rag": {
      "enabled": false,
      "note": "needs_confirmation_per_programme — section-level rag_rating columns used where relevant; enable global rag block when P0 FCDO template confirms"
    },
    "narrative_constraints": {
      "voice": "third_person_formal",
      "strict_word_limits": true
    },
    "extensions": {
      "submission_style": "structured_institutional_annual_review",
      "requires_logframe_or_equivalent": true,
      "requires_output_scoring": true,
      "requires_outcome_assessment": true,
      "requires_value_for_money_assessment": true,
      "requires_risk_assessment": true,
      "requires_evidence_assessment": true,
      "requires_forecast_vs_actual_cost_review": true,
      "requires_gender_age_or_vulnerability_disaggregation_where_relevant": true,
      "requires_recommendations_action_plan": true,
      "scoring_system": {
        "type": "five_point_output_scoring",
        "scope": "outputs_at_annual_review",
        "note": "Outcome is assessed at Annual Review; outputs are scored. PCR scoring differs."
      },
      "publication": {
        "annual_reviews_published_to_devtracker": true,
        "sensitivity_exclusions_possible": true
      },
      "source_note": "Normalized from WORKSTREAM_T2_NLCF_FCDO_REFERENCE_TEMPLATES.md §3.1. Global rag block disabled pending P0 grantee template confirmation."
    }
